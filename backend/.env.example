# PostgreSQL connection (REQUIRED)
# Для локальной разработки через docker-compose используй хост 'database'
# Для запуска без докера (напрямую) используй 'localhost'
DATABASE_URL=postgresql://docker:docker@database:5432/films

# Опционально: отдельные поля, если твой код их читает как fallback
# DATABASE_USERNAME=docker
# DATABASE_PASSWORD=docker
# DATABASE_DB=films

# App settings
NODE_ENV=development
PORT=3000

# Logging
LOGGER=dev
DEBUG=*
