
# ============================================================
# ЭТО ЧИТАЕТ DOCKER COMPOSE (docker-compose.yml)
# Эти переменные НЕ используются напрямую в коде приложения
# ============================================================

OWNER=aleksandr-danilyuk

# Суперпользователь PostgreSQL (создаётся автоматически)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

# Пользователь для приложения (его нужно создать вручную ИЛИ через скрипт)
DB_USER=docker
DB_PASSWORD=change_me
DB_NAME=films

# Настройки pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me


# Настройки окружения backend (подставляются в сервис backend)
# Локально: BACKEND_DEBUG=* и BACKEND_LOGGER=dev
# На сервере: BACKEND_DEBUG= (пусто) и BACKEND_LOGGER=tskv
BACKEND_PORT=3000
BACKEND_DEBUG=
BACKEND_LOGGER=dev